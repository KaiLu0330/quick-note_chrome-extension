{
  "manifest_version": 3,
  "name": "隨手記 (Quick Note)",
  "version": "1.0",
  "description": "一個極簡的自動儲存筆記本 chrome 插件",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}